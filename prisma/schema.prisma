generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}

enum LeadStatus {
  NEW_DISCOVERED
  AUDITED
  QUALIFIED
  CONTACT_READY
  OUTREACH_SENT
  IN_DISCUSSION
  CONVERTED
  UNQUALIFIED
  DO_NOT_CONTACT
}

enum AuditType {
  FULL_SCAN
  PSI_ONLY
  HTTP_HEAD_ONLY
}

enum AuditStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum FindingCategory {
  PERFORMANCE
  MOBILE_UX
  SEO_FOUNDATION
  SECURITY_SSL
  TECHNICAL_ERROR
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum CrawlAuditRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
  BLOCKED
}

enum CrawlUrlStatus {
  SCANNED
  FAILED
}

enum CrawlFindingResultStatus {
  PASS
  FAIL
  REVIEW_REQUIRED
  UNKNOWN
}

enum ContactType {
  EMAIL
  PHONE
  ZALO
  FACEBOOK_PAGE
  WEBSITE_FORM
  ADDRESS
}

enum OutreachChannel {
  EMAIL
  ZALO_MANUAL
  PHONE_SCRIPT
}

enum OutreachDraftStatus {
  DRAFT
  READY_TO_SEND
  SENT_MANUAL
  CANCELLED
}

enum OutreachEventType {
  DRAFT_CREATED
  DRAFT_REVIEWED
  MANUALLY_SENT
  CLIENT_REPLIED
  MEETING_SCHEDULED
  DECLINED
  BOUNCED_NO_REPLY
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String
  role           Role            @default(ADMIN)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  verifiedFindings AuditFinding[]  @relation("FindingVerifier")
  outreachEvents   OutreachEvent[]
  crawlFindingVerifications CrawlFindingVerification[]

  @@map("users")
}

model Business {
  id               String          @id @default(cuid())
  name             String
  industry         String          // vd: "Cho thuê xe máy", "Khách sạn", "Nhà hàng", "Dịch vụ địa phương"
  category         String?         // Chi tiết dịch vụ
  address          String?
  city             String          @default("Đà Nẵng")
  district         String?         // vd: "Sơn Trà", "Ngũ Hành Sơn", "Hải Châu"
  websiteUrl       String
  normalizedDomain String          @unique @db.VarChar(255) // vd: "thuexemaydanang.vn" - Đảm bảo chống trùng domain ở DB
  phone            String?
  email            String?
  dataSource       String?         // Nguồn dữ liệu: "Google Maps", "Thủ công", "CSV_IMPORT"
  collectedAt      DateTime        @default(now()) // Thời điểm thu thập dữ liệu
  leadStatus       LeadStatus      @default(NEW_DISCOVERED)
  opportunityScore Int?            // Nullable: null = chưa audit/chưa tính điểm, 0 = đã tính và đạt 0 điểm
  notes            String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  audits         WebsiteAudit[]
  findings       AuditFinding[]
  contactPoints  ContactPoint[]
  outreachDrafts OutreachDraft[]
  outreachEvents OutreachEvent[]
  crawlAuditRuns  CrawlAuditRun[]

  @@index([normalizedDomain])
  @@index([industry, city])
  @@index([opportunityScore(sort: Desc)])
  @@index([leadStatus])
  @@map("businesses")
}

model WebsiteAudit {
  id                  String         @id @default(cuid())
  businessId          String
  business            Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  auditType           AuditType      @default(FULL_SCAN)
  status              AuditStatus    @default(PENDING)

  // Điểm số Lighthouse / PageSpeed (0 - 100) - Nullable: phân biệt chưa có dữ liệu với điểm 0
  performanceScore    Int?
  seoScore            Int?
  accessibilityScore  Int?
  bestPracticesScore  Int?

  // Chỉ số chẩn đoán kỹ thuật
  loadTimeMs          Int?
  httpStatusCode      Int?
  isHttps             Boolean?       // Nullable: không mặc định true khi chưa kiểm tra
  isMobileFriendly    Boolean?

  // Core Web Vitals (Theo chuẩn mới: INP thay cho FID) - Nullable: phân biệt null với 0
  lcpMs               Float?         // Largest Contentful Paint (ms)
  clsScore            Float?         // Cumulative Layout Shift
  inpMs               Float?         // Interaction to Next Paint (ms - thay thế FID)
  fcpMs               Float?         // First Contentful Paint (ms)
  ttfbMs              Float?         // Time to First Byte (ms)

  rawDataJson         Json?          // Lưu raw audit payload chẩn đoán từ Google PageSpeed
  errorMessage        String?        @db.Text
  auditedAt           DateTime?
  createdAt           DateTime       @default(now())

  findings            AuditFinding[]

  @@index([businessId, createdAt(sort: Desc)])
  @@index([auditedAt])
  @@map("website_audits")
}

model AuditFinding {
  id                  String          @id @default(cuid())
  auditId             String
  audit               WebsiteAudit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  businessId          String
  business            Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  category            FindingCategory
  severity            FindingSeverity
  title               String          // vd: "Tốc độ tải trang di động quá chậm (> 5.2s)"
  description         String          @db.Text
  evidence            String          @db.Text // Thông số thực đo được, tài nguyên nặng, bằng chứng kỹ thuật
  impactExplanation   String          @db.Text // Giải thích ảnh hưởng kinh doanh thực tế
  recommendedSolution String          @db.Text // Giải pháp đề xuất khả thi

  // Trạng thái kiểm duyệt và xác minh thủ công
  status              FindingStatus   @default(PENDING) // PENDING, CONFIRMED, REJECTED
  verifiedAt          DateTime?
  verifiedByUserId    String?
  verifiedByUser      User?           @relation("FindingVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  createdAt           DateTime        @default(now())

  @@index([businessId])
  @@index([severity])
  @@index([status])
  @@map("audit_findings")
}

model CrawlAuditRun {
  id                         String               @id @default(cuid())
  businessId                 String
  business                   Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  rootUrl                    String               @db.VarChar(2048) // Sanitized snapshot; never persist URL credentials, fragments, or sensitive query values.
  rootHost                   String               @db.VarChar(253)
  requestedUrlLimit          Int
  depthLimit                 Int
  concurrencyLimit           Int
  status                     CrawlAuditRunStatus  @default(PENDING)
  startedAt                  DateTime?            @db.Timestamptz(3)
  finishedAt                 DateTime?            @db.Timestamptz(3)
  createdAt                  DateTime             @default(now()) @db.Timestamptz(3)
  scannerVersion             String               @db.VarChar(40)
  rulesetVersion             String               @db.VarChar(40)
  urlFingerprintKeyVersion   String               @db.VarChar(40)
  comparisonKeyVersion      String               @db.VarChar(40)
  idempotencyKey             String?              @db.VarChar(128)
  discoveredCount            Int                  @default(0)
  eligibleCount              Int                  @default(0)
  queuedCount                Int                  @default(0)
  attemptedCount             Int                  @default(0)
  succeededCount             Int                  @default(0)
  failedCount                Int                  @default(0)
  skippedRobotsCount         Int                  @default(0)
  skippedDepthCount          Int                  @default(0)
  skippedCandidateLimitCount Int                  @default(0)
  skippedScopeCount          Int                  @default(0)
  remainingCount             Int                  @default(0)
  limitReached               Boolean              @default(false)
  discoveryTruncated         Boolean              @default(false)
  downloadedBytes            BigInt               @default(0)
  stopReasonCode             String?              @db.VarChar(80)
  warningsJson               String?              @db.VarChar(4000) // Sanitized, bounded JSON string; never raw crawl payloads.
  urls                       CrawlScannedUrl[]
  findings                   CrawlAuditFinding[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, startedAt(sort: Desc)])
  @@index([status, startedAt])
  @@map("crawl_audit_runs")
}

model CrawlScannedUrl {
  id                String             @id @default(cuid())
  runId             String
  run               CrawlAuditRun      @relation(fields: [runId], references: [id], onDelete: Restrict)
  urlFingerprint    String             @db.VarChar(64) // HMAC-SHA-256 hex of canonical URL; urlFingerprintKeyVersion lives on the run.
  sanitizedUrl      String             @db.VarChar(2048)
  sanitizedFinalUrl String?            @db.VarChar(2048)
  depth             Int
  status            CrawlUrlStatus
  httpStatus        Int?
  statusText        String?            @db.VarChar(120)
  title             String?            @db.VarChar(500)
  metaDescription   String?            @db.VarChar(2000)
  responseTimeMs    Int?
  contentType       String?            @db.VarChar(255)
  contentLength     BigInt?
  scannedAt         DateTime           @db.Timestamptz(3)
  failureCode       String?            @db.VarChar(80)
  failureMessage    String?            @db.VarChar(1000)
  occurrences       CrawlFindingOccurrence[]

  @@unique([runId, id])
  @@unique([runId, urlFingerprint])
  @@index([runId, status])
  @@index([runId, depth])
  @@map("crawl_scanned_urls")
}

model CrawlAuditFinding {
  id               String                    @id @default(cuid())
  runId            String
  run              CrawlAuditRun             @relation(fields: [runId], references: [id], onDelete: Restrict)
  comparisonKey    String                    @db.VarChar(160) // Status-independent identity; compare only when comparisonKeyVersion matches.
  findingKey       String                    @db.VarChar(200) // Deterministic grouping key unique within this run; includes current result grouping.
  ruleId           String                    @db.VarChar(80)
  category         String                    @db.VarChar(40)
  severity         FindingSeverity
  resultStatus     CrawlFindingResultStatus
  ruleName         String                    @db.VarChar(160)
  description      String                    @db.VarChar(4000)
  recommendation   String                    @db.VarChar(4000)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  occurrences      CrawlFindingOccurrence[]
  verifications    CrawlFindingVerification[]

  @@unique([runId, id])
  @@unique([runId, findingKey])
  @@index([runId, comparisonKey])
  @@index([runId, resultStatus, severity])
  @@map("crawl_audit_findings")
}

model CrawlFindingOccurrence {
  id            String                    @id @default(cuid())
  runId         String
  findingId     String
  scannedUrlId  String
  finding       CrawlAuditFinding         @relation(fields: [runId, findingId], references: [runId, id], onDelete: Restrict)
  scannedUrl    CrawlScannedUrl           @relation(fields: [runId, scannedUrlId], references: [runId, id], onDelete: Restrict)
  resultStatus  CrawlFindingResultStatus
  evidence      String                    @db.VarChar(8000) // Bounded and scrubbed by the persistence boundary.
  observedAt    DateTime                  @default(now()) @db.Timestamptz(3)

  @@unique([runId, findingId, scannedUrlId])
  @@index([runId, findingId])
  @@index([runId, scannedUrlId])
  @@map("crawl_finding_occurrences")
}

model CrawlFindingVerification {
  id           String           @id @default(cuid())
  runId        String
  findingId    String
  finding      CrawlAuditFinding @relation(fields: [runId, findingId], references: [runId, id], onDelete: Restrict)
  status       FindingStatus
  note         String?          @db.VarChar(2000)
  actorUserId  String
  actorUser    User             @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  @@index([runId, findingId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("crawl_finding_verifications")
}

model ContactPoint {
  id               String       @id @default(cuid())
  businessId       String
  business         Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type             ContactType
  value            String       // Số điện thoại, email, link Fanpage, v.v.
  personName       String?      // Tên người liên hệ (nếu có công khai)
  roleTitle        String?      // Chức danh (Chủ quán, Quản lý đặt xe)
  source           String?      // Nguồn thông tin: "Website footer", "Fanpage", "Google Maps"
  isVerified       Boolean      @default(false)
  verifiedAt       DateTime?
  doNotContact     Boolean      @default(false) // Quy tắc chặn: không tiếp cận lại đầu mối này
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([businessId])
  @@index([doNotContact])
  @@map("contact_points")
}

model OutreachDraft {
  id                   String              @id @default(cuid())
  businessId           String
  business             Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  channel              OutreachChannel     @default(EMAIL)
  subject              String              // Tiêu đề email / tin nhắn
  body                 String              @db.Text // Nội dung cá nhân hóa đính kèm các finding thực tế
  personalizedPointers Json?               // Mảng findingId và bằng chứng được chọn làm dẫn chứng
  status               OutreachDraftStatus @default(DRAFT)
  sentAt               DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  events               OutreachEvent[]

  @@index([businessId])
  @@index([status])
  @@map("outreach_drafts")
}

model OutreachEvent {
  id             String            @id @default(cuid())
  draftId        String?
  draft          OutreachDraft?    @relation(fields: [draftId], references: [id], onDelete: SetNull)
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  eventType      OutreachEventType
  notes          String?           @db.Text
  loggedByUserId String?
  loggedByUser   User?             @relation(fields: [loggedByUserId], references: [id], onDelete: SetNull)
  occurredAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())

  @@index([businessId])
  @@index([draftId])
  @@map("outreach_events")
}
