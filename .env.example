# ==============================================================================
# LeadLift - Environment Configuration Example
# ==============================================================================

# Database Connection (Neon PostgreSQL)
# DATABASE_URL: Connection pooled URL (has -pooler in hostname) used by the Next.js runtime
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# DATABASE_URL_UNPOOLED: Direct unpooled connection used by Prisma CLI for migrations
DATABASE_URL_UNPOOLED="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require"

# Application Settings
NODE_ENV="development"
PORT=3000
