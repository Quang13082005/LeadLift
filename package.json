{
  "name": "leadlift",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test:foundation": "tsx scripts/test-foundation.ts",
    "test:audit-ui": "tsx scripts/test-audit-ui.tsx",
    "test:dashboard-business-ui": "tsx scripts/test-dashboard-business-ui.tsx",
    "test:business": "tsx scripts/test-business.ts && tsx scripts/test-business-regressions.ts",
    "test:scanner": "tsx scripts/test-scanner.ts",
    "test:crawler": "tsx scripts/test-crawler.ts",
    "test:crawl-audit-schema": "tsx scripts/test-crawl-audit-schema.ts",
    "test:crawl-persistence": "tsx scripts/test-crawl-persistence.ts",
    "postinstall": "prisma generate",
